<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Read-only access to on-device calendars (CLAUDE.md §7). Requested in context, never at startup. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Battery saver mode sets a still image as the wallpaper (ADR 0004). Normal permission: no prompt. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- Battery saver mode re-arms its triggers after a reboot (ADR 0004). Unused in live mode, where the
         receiver stays disabled. Normal permission: no prompt. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- The live wallpaper is the app's main feature (CLAUDE.md §10). -->
    <uses-feature
        android:name="android.software.live_wallpaper"
        android:required="true" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CalWallpaper"
        android:usesCleartextTraffic="false"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
