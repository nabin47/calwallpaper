<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network for Todoist sync only, over HTTPS (CLAUDE.md §7, ADR 0007). Normal permission: no prompt. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Read-only access to on-device calendars (CLAUDE.md §7). Requested in context, never at startup. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Battery saver mode sets a still image as the wallpaper (ADR 0004). Normal permission: no prompt. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- Battery saver mode re-arms its triggers after a reboot (ADR 0004). Unused in live mode, where the
         receiver stays disabled. Normal permission: no prompt. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- The live wallpaper is the app's main feature (CLAUDE.md §10). -->
    <uses-feature
        android:name="android.software.live_wallpaper"
        android:required="true" />

    <!-- Package visibility (Android 11+) for the deep-link router: lets it check which installed app can open a
         tap before trying it. Only these intents, never QUERY_ALL_PACKAGES (CLAUDE.md §4). The router still
         falls back to plain startActivity if a check misses an app. -->
    <queries>
        <!-- Calendar apps: a day (time URI) and an event occurrence, as typed by the Calendar Provider, plus
             apps that filter on the provider's URIs without a type. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data
                android:host="com.android.calendar"
                android:scheme="content" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data
                android:host="com.android.calendar"
                android:mimeType="time/epoch"
                android:scheme="content" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data
                android:host="com.android.calendar"
                android:mimeType="vnd.android.cursor.item/event"
                android:scheme="content" />
        </intent>
        <!-- The Todoist app's own links. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="todoist" />
        </intent>
        <!-- A browser for the web fallbacks. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.CalWallpaper"
        android:usesCleartextTraffic="false"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.CalWallpaper.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Long-press shortcut: quick-add to the local list. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Quick-add dialog (ADR 0007), opened by the Quick Settings tile and the launcher shortcut. Not exported:
             shortcuts and the tile start it as this app. -->
        <activity
            android:name=".quickadd.QuickAddActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="@string/quick_add_title"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.CalWallpaper.QuickAdd" />

        <!-- "Quick add" Quick Settings tile. Exported with BIND_QUICK_SETTINGS_TILE, so only System UI can bind it;
             the app needs no permission for this. -->
        <service
            android:name=".quickadd.QuickAddTileService"
            android:exported="true"
            android:icon="@drawable/ic_quick_add"
            android:label="@string/quick_add_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Deep-link router for wallpaper and widget taps (ADR 0005). No UI, not exported: only this app's own
             wallpaper and widgets reach it, by explicit component (OpenTargetLink.ROUTER_CLASS). Its empty task
             affinity keeps it out of the settings task. -->
        <activity
            android:name=".open.OpenTargetActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- Home-screen widgets (ADR 0005). Exported so the launcher and system can update them, as every
             widget provider must be; they only redraw. -->
        <receiver
            android:name=".widgets.AgendaWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_agenda_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_agenda_info" />
        </receiver>

        <receiver
            android:name=".widgets.WeekWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_week_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_week_info" />
        </receiver>
    </application>
</manifest>
