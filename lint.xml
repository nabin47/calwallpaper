<?xml version="1.0" encoding="UTF-8"?>
<!-- Shared Android Lint config. Warnings are errors (build-logic AndroidConfig.kt).
     Only "a newer version exists" checks are off: Dependabot handles upgrades,
     and these checks would turn every upstream release into a red CI. -->
<lint>
    <issue id="GradleDependency" severity="ignore" />
    <issue id="AndroidGradlePluginVersion" severity="ignore" />
    <issue id="NewerVersionAvailable" severity="ignore" />
</lint>
